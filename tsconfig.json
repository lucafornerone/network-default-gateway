{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "declaration": true,
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "types": ["bun"]
  },
  "include": ["tsc.d.ts", "index.ts", "src/**/*"]
}
