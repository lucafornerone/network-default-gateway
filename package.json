  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucafornerone/network-default-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/lucafornerone/network-default-gateway/issues"
  },
  "homepage": "https://github.com/lucafornerone/network-default-gateway#readme",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "chai": "^6.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mocha": "^11.8.0",
    "typescript": "^7.0.2"
  }
